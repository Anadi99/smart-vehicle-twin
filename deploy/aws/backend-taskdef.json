{
  "family": "smart-vehicle-twin-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "<ECR_URI>:latest",
      "portMappings": [{ "containerPort": 8000, "protocol": "tcp" }],
      "essential": true
    }
  ]
}
